# --- Backend ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=xpecto
PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES=24h
CORS_ORIGIN=http://localhost:5173
SEED_ON_START=true
UPLOAD_DIR=backend/uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Email (approval / rejection mails) ---
# If any of the first three are missing, emails are skipped (a warning is logged) and everything else works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords), not your login password
SMTP_APP_PASSWORD=
# Backward-compatible alternative:
# SMTP_PASSWORD=
# Optional
MAIL_FROM=your-account@gmail.com
MAIL_FROM_NAME=XPECTO
FEST_VENUE=IIT Mandi
FEST_DATES=20-22 February 2027
CONTACT_EMAIL=xpecto@students.iitmandi.ac.in
